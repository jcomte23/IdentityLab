@* One-time message left by a POST before redirecting (TempData["StatusMessage"]). *@
@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-start gap-2" role="status">
        @await Html.PartialAsync("_Icon", "check-circle")
        <p class="mb-0">@statusMessage</p>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
