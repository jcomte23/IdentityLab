@model ErrorViewModel

@{
    ViewData["Title"] = "Error";
    ViewData["Robots"] = "noindex, nofollow";
}

<div class="container container-narrow">
    <section class="surface panel text-center" aria-labelledby="page-title">
        <span class="icon-badge icon-badge--danger mb-3"><partial name="_Icon" model='"x-circle"' /></span>
        <h1 id="page-title" class="panel-title">Something went wrong</h1>
        <p class="panel-subtitle">An error occurred while processing your request. Please try again.</p>

        @if (Model.ShowRequestId)
        {
            <p class="small text-body-secondary mt-3 mb-0">Request ID: <code>@Model.RequestId</code></p>
        }

        <div class="auth-actions">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to home</a>
        </div>
    </section>
</div>
