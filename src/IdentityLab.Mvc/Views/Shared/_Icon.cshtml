@model string
@*
    Inline SVG icons (24x24, stroke-based). Decorative: hidden from screen readers.
    Usage: @await Html.PartialAsync("_Icon", "mail")
    Size and color come from CSS (.icon uses currentColor and 1.25em by default).
*@
@if (Model == "google")
{
    <svg class="icon" width="24" height="24" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
    </svg>
}
else
{
    <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        @switch (Model)
        {
            case "shield":
                <path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z"/>
                <path d="m9 12 2 2 4-4"/>
                break;
            case "user":
                <circle cx="12" cy="8" r="4"/>
                <path d="M4 21v-1a7 7 0 0 1 7-7h2a7 7 0 0 1 7 7v1"/>
                break;
            case "user-plus":
                <circle cx="9" cy="8" r="4"/>
                <path d="M2 21v-1a6 6 0 0 1 6-6h2a6 6 0 0 1 6 6v1"/>
                <path d="M19 8v6"/>
                <path d="M16 11h6"/>
                break;
            case "log-in":
                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                <path d="m10 17 5-5-5-5"/>
                <path d="M15 12H3"/>
                break;
            case "log-out":
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <path d="m16 17 5-5-5-5"/>
                <path d="M21 12H9"/>
                break;
            case "mail":
                <rect x="3" y="5" width="18" height="14" rx="2"/>
                <path d="m3 7 9 6 9-6"/>
                break;
            case "lock":
                <rect x="5" y="11" width="14" height="10" rx="2"/>
                <path d="M8 11V7a4 4 0 0 1 8 0v4"/>
                break;
            case "key":
                <circle cx="8" cy="15" r="4"/>
                <path d="m10.85 12.15 8.65-8.65"/>
                <path d="m18 5 2 2"/>
                <path d="m15 8 2 2"/>
                break;
            case "smartphone":
                <rect x="6" y="2" width="12" height="20" rx="2"/>
                <path d="M11 18h2"/>
                break;
            case "link":
                <path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/>
                <path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/>
                break;
            case "trash":
                <path d="M3 6h18"/>
                <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                <path d="m19 6-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                <path d="M10 11v6"/>
                <path d="M14 11v6"/>
                break;
            case "check-circle":
                <circle cx="12" cy="12" r="9"/>
                <path d="m8.5 12.5 2.5 2.5 5-5"/>
                break;
            case "x-circle":
                <circle cx="12" cy="12" r="9"/>
                <path d="m15 9-6 6"/>
                <path d="m9 9 6 6"/>
                break;
            case "alert":
                <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/>
                <path d="M12 9v4"/>
                <path d="M12 17h.01"/>
                break;
            case "info":
                <circle cx="12" cy="12" r="9"/>
                <path d="M12 16v-4"/>
                <path d="M12 8h.01"/>
                break;
            case "arrow-right":
                <path d="M5 12h14"/>
                <path d="m12 5 7 7-7 7"/>
                break;
            case "arrow-left":
                <path d="M19 12H5"/>
                <path d="m12 19-7-7 7-7"/>
                break;
            case "copy":
                <rect x="9" y="9" width="12" height="12" rx="2"/>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                break;
            case "download":
                <path d="M12 3v12"/>
                <path d="m7 10 5 5 5-5"/>
                <path d="M5 21h14"/>
                break;
            default:
                <circle cx="12" cy="12" r="9"/>
                break;
        }
    </svg>
}
