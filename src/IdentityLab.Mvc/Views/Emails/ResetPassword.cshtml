@model ResetPasswordEmailModel

@{
    Layout = "/Views/Emails/_EmailLayout.cshtml";
    ViewData["Title"] = "Reset your password";
    ViewData["Preheader"] = "Use this link to choose a new password for your IdentityLab account.";
}

<h1 style="margin: 0 0 16px; font-size: 24px; line-height: 32px; font-weight: 700; color: #101828; letter-spacing: -0.3px;">
    Reset your password
</h1>

<p style="margin: 0 0 16px;">Hi @Model.DisplayName,</p>

<p style="margin: 0;">
    We received a request to reset the password for your IdentityLab account. Click the button below to choose a new one.
</p>

<partial name="/Views/Emails/_EmailButton.cshtml" model='new EmailButtonModel("Reset password", Model.ResetUrl)' />

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 32px;">
    <tr>
        <td style="padding: 16px; border-radius: 10px; background-color: #fffaeb; font-size: 14px; line-height: 22px; color: #93370d;">
            <strong>Didn't ask for this?</strong> You can ignore this email: your password won't change.
            The link works only once and expires in 24 hours.
        </td>
    </tr>
</table>
