@model ConfirmEmailModel

@{
    Layout = "/Views/Emails/_EmailLayout.cshtml";
    ViewData["Title"] = "Confirm your email address";
    ViewData["Preheader"] = "One click to activate your IdentityLab account.";
}

<h1 style="margin: 0 0 16px; font-size: 24px; line-height: 32px; font-weight: 700; color: #101828; letter-spacing: -0.3px;">
    Confirm your email address
</h1>

<p style="margin: 0 0 16px;">Hi @Model.DisplayName,</p>

<p style="margin: 0;">
    Thanks for signing up for IdentityLab! Please confirm that this is your email address to activate your account.
</p>

<partial name="/Views/Emails/_EmailButton.cshtml" model='new EmailButtonModel("Confirm email address", Model.ConfirmationUrl)' />

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 32px;">
    <tr>
        <td style="padding-top: 24px; border-top: 1px solid #e4e7ec; font-size: 14px; line-height: 22px; color: #667085;">
            This link expires in <strong style="color: #344054;">24 hours</strong>.
            If you didn't create an IdentityLab account, you can safely ignore this email.
        </td>
    </tr>
</table>
