@model ManageIndexViewModel

@{
    Layout = "_ManageLayout";
    ViewData["Title"] = "My account";
    var displayName = string.IsNullOrWhiteSpace(Model.FullName) ? Model.UserName : Model.FullName;
    var initial = displayName.Length > 0 ? char.ToUpperInvariant(displayName[0]).ToString() : "?";
}

<header class="profile-header">
    <span class="avatar avatar--xl" aria-hidden="true">@initial</span>
    <div class="min-w-0">
        <h1 class="profile-name text-truncate">@displayName</h1>
        <p class="profile-handle text-truncate">@@@Model.UserName</p>
    </div>
</header>

<section class="surface settings-card" aria-labelledby="profile-title">
    <header class="settings-card__header">
        <h2 id="profile-title" class="settings-card__title">Profile</h2>
        <p class="settings-card__subtitle">Your personal information.</p>
    </header>

    <dl class="detail-list">
        <div>
            <dt>Full name</dt>
            <dd>
                @if (string.IsNullOrWhiteSpace(Model.FullName))
                {
                    <span class="text-body-secondary fst-italic">Not set</span>
                }
                else
                {
                    @Model.FullName
                }
            </dd>
        </div>
        <div>
            <dt>Username</dt>
            <dd>@Model.UserName</dd>
        </div>
        <div>
            <dt>Email</dt>
            <dd>
                <span>@Model.Email</span>
                @if (Model.EmailConfirmed)
                {
                    <span class="status status--success">Verified</span>
                }
                else
                {
                    <span class="status status--warning">Not verified</span>
                }
            </dd>
        </div>
    </dl>
</section>

<section class="surface settings-card" aria-labelledby="security-title">
    <header class="settings-card__header">
        <h2 id="security-title" class="settings-card__title">Security</h2>
        <p class="settings-card__subtitle">Control how you sign in to IdentityLab.</p>
    </header>

    <ul class="settings-list">
        <li class="settings-item">
            <span class="settings-item__icon">@await Html.PartialAsync("_Icon", "lock")</span>
            <div>
                <h3 class="settings-item__title">Password</h3>
                <p class="settings-item__text">
                    @(Model.HasPassword
                        ? "You can log in with your email or username and password."
                        : "Your account doesn't have a password. You log in with an external provider.")
                </p>
            </div>
            <div class="settings-item__actions">
                @if (Model.HasPassword)
                {
                    <span class="status status--success">Set</span>
                }
                else
                {
                    <span class="status">Not set</span>
                }
            </div>
        </li>

        <li class="settings-item">
            <span class="settings-item__icon">@await Html.PartialAsync("_Icon", "smartphone")</span>
            <div>
                <h3 class="settings-item__title">Two-factor authentication</h3>
                <p class="settings-item__text">Add an extra layer of security with an authenticator app.</p>
            </div>
            <div class="settings-item__actions">
                @if (Model.TwoFactorEnabled)
                {
                    <span class="status status--success">Enabled</span>
                    <form asp-action="Disable2fa" method="post"
                          data-confirm="Disable two-factor authentication? You will need to scan a new QR code to enable it again.">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Disable</button>
                    </form>
                }
                else
                {
                    <span class="status">Not enabled</span>
                    <a asp-action="EnableAuthenticator" class="btn btn-primary btn-sm">Set up</a>
                }
            </div>
        </li>

        @if (Model.TwoFactorEnabled)
        {
            var isRunningLow = Model.RecoveryCodesLeft <= 3;

            <li class="settings-item">
                <span class="settings-item__icon">@await Html.PartialAsync("_Icon", "key")</span>
                <div>
                    <h3 class="settings-item__title">Recovery codes</h3>
                    <p class="settings-item__text">One-time codes to log in if you lose access to your authenticator app.</p>
                    @if (isRunningLow)
                    {
                        <p class="settings-item__note">
                            @(Model.RecoveryCodesLeft == 0
                                ? "You have no recovery codes left. Generate new ones."
                                : "You're running low on recovery codes. Consider generating new ones.")
                        </p>
                    }
                </div>
                <div class="settings-item__actions">
                    <span class="status @(isRunningLow ? "status--warning" : "status--success")">@Model.RecoveryCodesLeft left</span>
                    <form asp-action="GenerateRecoveryCodes" method="post"
                          data-confirm="Generating new codes will invalidate your current recovery codes. Continue?">
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Generate new</button>
                    </form>
                </div>
            </li>
        }

        <li class="settings-item">
            <span class="settings-item__icon">@await Html.PartialAsync("_Icon", "link")</span>
            <div>
                <h3 class="settings-item__title">Linked logins</h3>
                <p class="settings-item__text">External accounts you can use to log in.</p>
            </div>
            <div class="settings-item__actions">
                @if (Model.ExternalLogins.Count == 0)
                {
                    <span class="status">None</span>
                }
                @foreach (var provider in Model.ExternalLogins)
                {
                    <span class="status status--brand">@provider</span>
                }
            </div>
        </li>
    </ul>
</section>

<section class="surface settings-card settings-card--danger" aria-labelledby="danger-title">
    <div class="settings-item">
        <span class="settings-item__icon settings-item__icon--danger">@await Html.PartialAsync("_Icon", "trash")</span>
        <div>
            <h2 id="danger-title" class="settings-item__title">Delete account</h2>
            <p class="settings-item__text">Permanently delete your account and all its data. This can't be undone.</p>
        </div>
        <div class="settings-item__actions">
            <a asp-action="DeleteAccount" class="btn btn-outline-danger btn-sm">Delete account</a>
        </div>
    </div>
</section>
