@model string[]

@{
    Layout = "_ManageLayout";
    ViewData["Title"] = "Recovery codes";
}

<section class="surface panel" aria-labelledby="page-title">
    <header class="panel-header">
        <span class="icon-badge icon-badge--warning"><partial name="_Icon" model='"key"' /></span>
        <div>
            <h1 id="page-title" class="panel-title">Your recovery codes</h1>
            <p class="panel-subtitle">Use one of these if you lose access to your authenticator app.</p>
        </div>
    </header>

    <p class="callout callout--warning" role="note">
        <partial name="_Icon" model='"alert"' />
        <span>
            <strong>Save these codes now.</strong> This is the only time they will be shown.
            Each code works only once. Store them somewhere safe, like a password manager.
        </span>
    </p>

    <ul id="recoveryCodes" class="recovery-codes" aria-label="Recovery codes">
        @foreach (var recoveryCode in Model)
        {
            <li><code>@recoveryCode</code></li>
        }
    </ul>

    <div class="panel-actions">
        <button type="button" class="btn btn-outline-secondary" data-copy-target="#recoveryCodes">Copy all</button>
        <button type="button" class="btn btn-outline-secondary" data-download-target="#recoveryCodes"
                data-download-name="identitylab-recovery-codes.txt">Download</button>
        <a asp-action="Index" class="btn btn-primary ms-sm-auto">I've saved them</a>
    </div>
</section>
