@model string[]

@{
    ViewData["Title"] = "Your recovery codes";
}

<div class="row justify-content-center py-md-3">
    <div class="col-lg-8 col-xl-7">

        @if (TempData["StatusMessage"] is string statusMessage)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @statusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning-subtle text-warning-emphasis flex-shrink-0"
                         style="width: 3.5rem; height: 3.5rem;">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="8" cy="15" r="4"/>
                            <path d="m10.85 12.15 8.65-8.65"/>
                            <path d="m18 5 2 2"/>
                            <path d="m15 8 2 2"/>
                        </svg>
                    </div>
                    <div>
                        <h1 class="h4 fw-semibold mb-1">@ViewData["Title"]</h1>
                        <p class="text-body-secondary mb-0">Use one of these if you lose access to your authenticator app.</p>
                    </div>
                </div>

                <div class="alert alert-warning small" role="alert">
                    <strong>Save these codes now.</strong> This is the only time they will be shown.
                    Each code can be used only once. Store them somewhere safe, like a password manager.
                </div>

                <div id="recoveryCodes" class="row row-cols-2 g-2 bg-body-tertiary rounded-3 p-3 mx-0 mb-3">
                    @foreach (var recoveryCode in Model)
                    {
                        <div class="col"><code class="fs-6 text-body">@recoveryCode</code></div>
                    }
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="button" id="copyCodes" class="btn btn-outline-secondary">Copy all</button>
                    <a asp-action="Index" class="btn btn-primary ms-auto">I've saved them</a>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('copyCodes').addEventListener('click', async function () {
            const codes = Array.from(document.querySelectorAll('#recoveryCodes code'))
                .map(c => c.textContent.trim())
                .join('\n');
            try {
                await navigator.clipboard.writeText(codes);
                this.textContent = 'Copied!';
            } catch {
                this.textContent = 'Select and copy manually';
            }
            setTimeout(() => this.textContent = 'Copy all', 2000);
        });
    </script>
}
