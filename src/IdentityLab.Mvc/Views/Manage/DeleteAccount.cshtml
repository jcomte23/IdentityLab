@model DeleteAccountViewModel

@{
    Layout = "_ManageLayout";
    ViewData["Title"] = "Delete account";
}

<section class="surface panel panel--danger" aria-labelledby="page-title">
    <header class="panel-header">
        <span class="icon-badge icon-badge--danger">@await Html.PartialAsync("_Icon", "trash")</span>
        <div>
            <h1 id="page-title" class="panel-title">Delete account</h1>
            <p class="panel-subtitle">This action is permanent and can't be undone.</p>
        </div>
    </header>

    <aside class="callout callout--danger" aria-labelledby="delete-warning-title">
        @await Html.PartialAsync("_Icon", "alert")
        <div>
            <h2 id="delete-warning-title" class="callout-title">This will permanently delete:</h2>
            <ul>
                <li>Your profile and sign-in details.</li>
                <li>Linked logins, like Google.</li>
                <li>Your two-factor settings and recovery codes.</li>
            </ul>
        </div>
    </aside>

    <form asp-action="DeleteAccount" method="post" class="mt-4">
        <div asp-validation-summary="ModelOnly" role="alert"></div>

        @if (Model.RequirePassword)
        {
            <label asp-for="Password" class="form-label">Enter your password to confirm</label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" required />
            <span asp-validation-for="Password"></span>
        }
        else
        {
            <label asp-for="Confirmation" class="form-label">Type <strong>@Model.UserName</strong> to confirm</label>
            <input asp-for="Confirmation" class="form-control" autocomplete="off" autocapitalize="off"
                   spellcheck="false" required />
            <span asp-validation-for="Confirmation"></span>
        }

        <div class="panel-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-danger ms-sm-auto">Delete my account</button>
        </div>
    </form>
</section>
