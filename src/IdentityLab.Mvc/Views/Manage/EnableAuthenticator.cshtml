@model EnableAuthenticatorViewModel

@{
    Layout = "_ManageLayout";
    ViewData["Title"] = "Set up authenticator app";
}

<section class="surface panel" aria-labelledby="page-title">
    <header class="panel-header">
        <span class="icon-badge"><partial name="_Icon" model='"smartphone"' /></span>
        <div>
            <h1 id="page-title" class="panel-title">Set up authenticator app</h1>
            <p class="panel-subtitle">Use an authenticator app to generate one-time login codes.</p>
        </div>
    </header>

    <ol class="steps">
        <li>
            <h2 class="step-title">Install an authenticator app</h2>
            <p class="step-text mb-0">For example Google Authenticator or Microsoft Authenticator, on your phone.</p>
        </li>

        <li>
            <h2 class="step-title">Scan this QR code with the app</h2>
            <p class="step-text">In the app, tap <em>"+"</em> and choose <em>"Scan a QR code"</em>.</p>

            <figure class="qr-frame">
                <img src="@Model.QrCodeImage" alt="QR code to add IdentityLab to your authenticator app" width="176" height="176" />
            </figure>

            <details class="manual-key">
                <summary>Can't scan it? Enter the key manually</summary>
                <p class="step-text">
                    Choose <em>"Enter a setup key"</em>, type this key and select <em>"Time based"</em>.
                    Spaces and letter case don't matter.
                </p>
                <div class="key-row">
                    <code id="sharedKey" class="secret-key">@Model.SharedKey</code>
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-copy-target="#sharedKey">Copy</button>
                </div>
            </details>
        </li>

        <li>
            <h2 class="step-title">Enter the 6-digit code from the app</h2>
            <p class="step-text">This confirms the app is set up correctly and turns on two-factor authentication.</p>

            <form asp-action="EnableAuthenticator" method="post" class="otp-form">
                <div class="otp-form__field">
                    <label asp-for="Code" class="visually-hidden"></label>
                    <input asp-for="Code" class="form-control form-control-lg otp-input" inputmode="numeric"
                           autocomplete="one-time-code" placeholder="000000" />
                    <span asp-validation-for="Code"></span>
                </div>
                <button type="submit" class="btn btn-primary btn-lg">Verify and enable</button>
            </form>
        </li>
    </ol>

    <p class="callout callout--warning mt-4">
        <partial name="_Icon" model='"alert"' />
        <span>Keep this key private. Anyone who has it can generate your login codes.</span>
    </p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
