@model ForgotPasswordViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot your password?";
}

<header class="auth-header">
    <span class="icon-badge"><partial name="_Icon" model='"key"' /></span>
    <h1 id="page-title" class="auth-title">Forgot your password?</h1>
    <p class="auth-subtitle">Enter your email and we'll send you a link to reset it.</p>
</header>

@* No validation summary on purpose: this form never reveals whether an account exists. *@
<form asp-action="ForgotPassword" method="post">
    <div class="mb-4">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="email" placeholder="jane@example.com" />
        <span asp-validation-for="Email"></span>
    </div>

    <button type="submit" class="btn btn-primary btn-lg w-100">Send reset link</button>
</form>

<p class="auth-footer">
    Remembered it? <a asp-action="Login">Back to login</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
