@model RegisterViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Create account";
    ViewData["Description"] = "Create your IdentityLab account with an email and password, or continue with Google.";
    ViewData["Robots"] = "index, follow";
    ViewData["AuthCardClass"] = "auth-card--wide";
}

<header class="auth-header">
    <span class="icon-badge"><partial name="_Icon" model='"user-plus"' /></span>
    <h1 id="page-title" class="auth-title">Create your account</h1>
    <p class="auth-subtitle">It only takes a minute.</p>
</header>

<partial name="_GoogleSignIn" />

<p class="auth-divider">or sign up with your email</p>

<form asp-action="Register" method="post">
    <div asp-validation-summary="ModelOnly" role="alert"></div>

    <fieldset class="form-section">
        <legend class="form-section-title">Your details</legend>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="FullName" class="form-label">Full name <span class="optional">(optional)</span></label>
                <input asp-for="FullName" class="form-control" autocomplete="name" placeholder="Jane Doe" />
                <span asp-validation-for="FullName"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="UserName" class="form-label"></label>
                <input asp-for="UserName" class="form-control" autocomplete="username" placeholder="janedoe"
                       aria-describedby="userNameHelp" />
                <span asp-validation-for="UserName"></span>
                <p id="userNameHelp" class="form-text mb-0">Letters, numbers, dots, underscores and hyphens.</p>
            </div>

            <div class="col-12">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" placeholder="jane@example.com" />
                <span asp-validation-for="Email"></span>
            </div>
        </div>
    </fieldset>

    <fieldset class="form-section">
        <legend class="form-section-title">Choose a password</legend>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" aria-describedby="passwordHelp" />
                <span asp-validation-for="Password"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>
        </div>
        <p id="passwordHelp" class="form-text mt-2 mb-0">
            At least 6 characters, including an uppercase letter, a lowercase letter, a number and a symbol.
        </p>
    </fieldset>

    <button type="submit" class="btn btn-primary btn-lg w-100 mt-4">Create account</button>
</form>

<p class="auth-footer">
    Already have an account? <a asp-action="Login">Log in</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
