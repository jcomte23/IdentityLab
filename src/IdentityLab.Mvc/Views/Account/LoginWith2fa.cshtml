@model LoginWith2faViewModel

@{
    ViewData["Title"] = "Two-factor authentication";
}

<div class="row justify-content-center py-md-3">
    <div class="col-sm-10 col-md-7 col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary mb-3"
                         style="width: 3.5rem; height: 3.5rem;">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="6" y="2" width="12" height="20" rx="2"/>
                            <path d="M11 18h2"/>
                        </svg>
                    </div>
                    <h1 class="h3 fw-semibold mb-1">@ViewData["Title"]</h1>
                    <p class="text-body-secondary mb-0">Enter the 6-digit code from your authenticator app.</p>
                </div>

                <form asp-action="LoginWith2fa" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                    <input asp-for="RememberMe" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="Code" class="form-label fw-medium"></label>
                        <input asp-for="Code" class="form-control form-control-lg text-center font-monospace"
                               style="letter-spacing: .3em;" inputmode="numeric" autocomplete="one-time-code"
                               placeholder="123456" autofocus />
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMachine" class="form-check-input" />
                        <label asp-for="RememberMachine" class="form-check-label"></label>
                        <div class="form-text mt-0">Don't ask for a code again on this browser.</div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100">Verify</button>
                </form>

                <p class="text-center text-body-secondary small mt-4 mb-0">
                    Lost access to your authenticator app?
                    <a asp-action="LoginWithRecoveryCode" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="text-decoration-none">
                        Use a recovery code
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
