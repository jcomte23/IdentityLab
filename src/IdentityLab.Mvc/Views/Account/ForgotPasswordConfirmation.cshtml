@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Check your email";
}

<header class="auth-header">
    <span class="icon-badge icon-badge--success"><partial name="_Icon" model='"mail"' /></span>
    <h1 id="page-title" class="auth-title">Check your email</h1>
    <p class="auth-subtitle">If an account with that email exists, we've sent you a link to reset your password.</p>
</header>

<p class="callout">
    <partial name="_Icon" model='"info"' />
    <span>The link works only once and expires in 24 hours. Check your spam folder if you can't find it.</span>
</p>

<div class="auth-actions">
    <a asp-action="Login" class="btn btn-primary">Back to login</a>
</div>
