@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Password updated";
}

<header class="auth-header">
    <span class="icon-badge icon-badge--success">@await Html.PartialAsync("_Icon", "check-circle")</span>
    <h1 id="page-title" class="auth-title">Password updated</h1>
    <p class="auth-subtitle">Your password has been reset. For your security, other sessions will be signed out.</p>
</header>

<a asp-action="Login" class="btn btn-primary btn-lg w-100">Log in</a>
