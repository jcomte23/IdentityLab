@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Check your email";
}

<header class="auth-header">
    <span class="icon-badge icon-badge--success"><partial name="_Icon" model='"mail"' /></span>
    <h1 id="page-title" class="auth-title">Check your email</h1>
    <p class="auth-subtitle">Your account has been created. We've sent you a link to confirm your email address.</p>
</header>

<aside class="callout" aria-labelledby="email-help-title">
    <partial name="_Icon" model='"info"' />
    <div>
        <h2 id="email-help-title" class="callout-title">Didn't get the email?</h2>
        <ul>
            <li>Check your spam or junk folder.</li>
            <li>Make sure you entered the right email address.</li>
            <li>The link expires in 24 hours.</li>
        </ul>
    </div>
</aside>

<div class="auth-actions">
    <a asp-action="Login" class="btn btn-primary">Go to login</a>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Back to home</a>
</div>
