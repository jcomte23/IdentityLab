@{
    ViewData["Title"] = "Check your email";
}

<div class="row justify-content-center py-md-3">
    <div class="col-sm-11 col-md-8 col-lg-6 col-xl-5">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body p-4 p-md-5">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success-subtle text-success mb-4"
                     style="width: 4.5rem; height: 4.5rem;">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="5" width="18" height="14" rx="2"/>
                        <path d="m3 7 9 6 9-6"/>
                    </svg>
                </div>

                <h1 class="h3 fw-semibold mb-2">@ViewData["Title"]</h1>
                <p class="text-body-secondary mb-4">
                    Your account has been created. We've sent you a confirmation link to activate it.
                </p>

                <div class="bg-body-tertiary rounded-3 p-3 text-start small mb-4">
                    <p class="fw-semibold mb-2">Didn't get the email?</p>
                    <ul class="mb-0 ps-3 text-body-secondary">
                        <li>Check your spam or junk folder.</li>
                        <li>Make sure you entered the right email address.</li>
                        <li>The link expires in 24 hours.</li>
                    </ul>
                </div>

                <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                    <a asp-action="Login" class="btn btn-primary px-4">Go to login</a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4">Back to home</a>
                </div>
            </div>
        </div>
    </div>
</div>
