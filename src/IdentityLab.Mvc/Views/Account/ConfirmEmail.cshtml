@model bool

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = Model ? "Email confirmed" : "Email not confirmed";
}

@if (Model)
{
    <header class="auth-header">
        <span class="icon-badge icon-badge--success">@await Html.PartialAsync("_Icon", "check-circle")</span>
        <h1 id="page-title" class="auth-title">Email confirmed</h1>
        <p class="auth-subtitle">Thank you for confirming your email. You can now log in.</p>
    </header>

    <a asp-action="Login" class="btn btn-primary btn-lg w-100">Log in</a>
}
else
{
    <header class="auth-header">
        <span class="icon-badge icon-badge--danger">@await Html.PartialAsync("_Icon", "x-circle")</span>
        <h1 id="page-title" class="auth-title">We couldn't confirm your email</h1>
        <p class="auth-subtitle">The link may be invalid or expired.</p>
    </header>

    <div class="auth-actions">
        <a asp-action="Login" class="btn btn-primary">Go to login</a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Back to home</a>
    </div>
}
