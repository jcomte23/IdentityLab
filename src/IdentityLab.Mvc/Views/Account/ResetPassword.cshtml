@model ResetPasswordViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Set a new password";
}

<header class="auth-header">
    <span class="icon-badge">@await Html.PartialAsync("_Icon", "lock")</span>
    <h1 id="page-title" class="auth-title">Set a new password</h1>
    <p class="auth-subtitle">Choose a new password for your account.</p>
</header>

<form asp-action="ResetPassword" method="post">
    <div asp-validation-summary="ModelOnly" role="alert"></div>

    <input asp-for="Code" type="hidden" />

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="username" placeholder="jane@example.com" />
        <span asp-validation-for="Email"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" aria-describedby="passwordHelp" />
        <span asp-validation-for="Password"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword"></span>
    </div>

    <p id="passwordHelp" class="form-text mb-4">
        At least 6 characters, including an uppercase letter, a lowercase letter, a number and a symbol.
    </p>

    <button type="submit" class="btn btn-primary btn-lg w-100">Reset password</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
