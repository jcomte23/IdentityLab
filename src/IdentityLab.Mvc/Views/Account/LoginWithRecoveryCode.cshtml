@model LoginWithRecoveryCodeViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Log in with a recovery code";
}

<header class="auth-header">
    <span class="icon-badge icon-badge--warning">@await Html.PartialAsync("_Icon", "key")</span>
    <h1 id="page-title" class="auth-title">Use a recovery code</h1>
    <p class="auth-subtitle">Enter one of the codes you saved when you enabled two-factor authentication.</p>
</header>

<form asp-action="LoginWithRecoveryCode" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
    <div asp-validation-summary="ModelOnly" role="alert"></div>

    <div class="mb-4">
        <label asp-for="RecoveryCode" class="form-label"></label>
        <input asp-for="RecoveryCode" class="form-control otp-input" autocomplete="off" spellcheck="false"
               placeholder="XXXXX-XXXXX" aria-describedby="recoveryCodeHelp" autofocus />
        <span asp-validation-for="RecoveryCode"></span>
        <p id="recoveryCodeHelp" class="form-text mb-0">Each recovery code works only once.</p>
    </div>

    <button type="submit" class="btn btn-primary btn-lg w-100">Log in</button>
</form>

<p class="auth-footer">
    Have your phone?
    <a asp-action="LoginWith2fa" asp-route-returnUrl="@ViewData["ReturnUrl"]">Use the authenticator app</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
